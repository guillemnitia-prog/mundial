# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git.

# --- APIs de datos ---
FOOTBALL_DATA_TOKEN=        # https://www.football-data.org/client/register (free)
ODDS_API_KEY=              # https://the-odds-api.com (free 500 créditos/mes)
ODDSPAPI_KEY=              # opcional, para línea Pinnacle (free 250 req/mes)
API_FOOTBALL_KEY=          # opcional, alineaciones/lesiones (free 100 req/día)

# --- Notificaciones push (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=          # generar en el setup (pywebpush / vapid)
VAPID_PRIVATE_KEY=         # NUNCA versionar
VAPID_SUBJECT=mailto:admin@example.com  # contacto requerido por VAPID

# --- Auth ---
JWT_SECRET=                # cadena larga aleatoria (p.ej. openssl rand -hex 32)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 días
COOKIE_NAME=access_token   # cookie httpOnly que transporta el JWT
COOKIE_SECURE=false        # true en producción (HTTPS)
COOKIE_SAMESITE=lax        # lax en dev
FRONTEND_ORIGIN=http://localhost:3000  # origen de la PWA Next.js (CORS con credenciales)

# --- Parámetros de dominio ---
MIN_ODDS=1.40              # cuota mínima de los pronósticos
MIN_CONFIDENCE=0.70        # prob. mínima del modelo para recomendar (alta confianza + EV>0)
KELLY_FRACTION=0.25        # 1/4 Kelly
MIN_STAKE_EUR=1.0          # mínimo de la casa por apuesta (€)
MAX_STAKE_PCT=0.05         # tope: 5% del bankroll por apuesta
GROUP_BANKROLL=350         # 7 amigos x 50 €

# --- Datos ---
DATABASE_URL=sqlite:///data/worldcup.db
ODDS_REGION=eu             # The Odds API no tiene región ES; eu como proxy
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITION=WC  # FIFA World Cup
ELORATINGS_URL=https://www.eloratings.net/World.tsv  # Elo de selecciones
