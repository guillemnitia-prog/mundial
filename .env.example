# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git.

# --- APIs de datos ---
FOOTBALL_DATA_TOKEN=        # https://www.football-data.org/client/register (free)
ODDS_API_KEY=              # https://the-odds-api.com (free 500 créditos/mes)
ODDSPAPI_KEY=              # opcional, para línea Pinnacle (free 250 req/mes)
API_FOOTBALL_KEY=          # opcional, alineaciones/lesiones (free 100 req/día)

# --- Auth ---
JWT_SECRET=                # cadena larga aleatoria (p.ej. openssl rand -hex 32)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080   # 7 días

# --- Parámetros de dominio ---
MIN_ODDS=1.40              # cuota mínima de los pronósticos
KELLY_FRACTION=0.25        # 1/4 Kelly
MAX_STAKE_PCT=0.05         # tope: 5% del bankroll por apuesta
GROUP_BANKROLL=350         # 7 amigos x 50 €

# --- Datos ---
DATABASE_URL=sqlite:///data/worldcup.db
ODDS_REGION=eu             # The Odds API no tiene región ES; eu como proxy
